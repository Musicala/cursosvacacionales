rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Coordinación: lectura y escritura total.
    function esAdmin() {
      return request.auth != null && request.auth.token.email in [
        "musicalaasesor@gmail.com",
        "imusicala@gmail.com",
        "catalina.medina.leal@gmail.com",
        "alekcaballeromusic@gmail.com",
        "adminmusicala@gmail.com"
      ];
    }

    // Correos de docentes registrados (campo plano guardado desde la app).
    function correosDocentes() {
      return get(/databases/$(database)/documents/config/global).data.get('docentesCorreos', []);
    }

    // Docente: si su correo está en la lista de docentes.
    function esDocente() {
      return request.auth != null
        && request.auth.token.email.lower() in correosDocentes();
    }

    // Subcolecciones operativas que el docente SÍ puede editar.
    function correoAuth() {
      return request.auth.token.email.lower();
    }

    function esClasePropia() {
      return resource.data.get('docenteCorreo', '') == correoAuth();
    }

    // La clase quedó con correo vacío o con un correo que ya no es de ningún
    // docente vigente (ej: se corrigió un correo mal escrito). En ese caso el
    // docente puede reclamarla poniendo su propio correo.
    function puedeReclamarClase() {
      return !(resource.data.get('docenteCorreo', '') in correosDocentes())
        && request.resource.data.get('docenteCorreo', '') == correoAuth();
    }

    function soloEditaPlaneacion() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'planeacion',
        'actividades',
        'recursos',
        'observacionesPlaneacion',
        'docenteCorreo',
        'actualizado'
      ]);
    }

    match /config/global {
      allow read: if request.auth != null;
      allow write: if esAdmin();
    }

    match /temporadas/{temporadaId}/grupos/{grupoId} {
      allow read: if esAdmin() || esDocente();
      allow create, delete: if esAdmin();
      allow update: if esAdmin()
        || (esDocente() && soloEditaPlaneacion()
            && (esClasePropia() || puedeReclamarClase()));
    }

    match /temporadas/{temporadaId}/{sub}/{docId} {
      allow read: if esAdmin() || esDocente();
      allow write: if esAdmin()
        || (esDocente() && sub in ['asistencia', 'musicafe', 'materiales']);
    }

    // Todo lo demás: docente solo lectura, coordinación escribe.
    match /{document=**} {
      allow read: if esAdmin() || esDocente();
      allow write: if esAdmin();
    }
  }
}
