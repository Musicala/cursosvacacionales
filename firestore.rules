rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Coordinación (Admin + Asistente): lectura y escritura total.
    // La diferencia Admin/Asistente se aplica en la app (firebase-config.js):
    // el Asistente no ve el módulo Estadísticas. No se separa aquí porque
    // Estadísticas solo agrega datos de inscripciones/musicafé, que el
    // Asistente igual necesita para su trabajo diario.
    function esAdmin() {
      return request.auth != null && request.auth.token.email in [
        "musicalaasesor@gmail.com",
        "imusicala@gmail.com",
        "catalina.medina.leal@gmail.com",
        "alekcaballeromusic@gmail.com",
        "adminmusicala@gmail.com"
      ];
    }

    // Correos de docentes registrados (campo plano guardado desde la app).
    function correosDocentes() {
      return get(/databases/$(database)/documents/config/global).data.get('docentesCorreos', []);
    }

    // Docente: si su correo está en la lista de docentes.
    function esDocente() {
      return request.auth != null
        && request.auth.token.email.lower() in correosDocentes();
    }

    function soloEditaPlaneacion() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'planeacion',
        'actividades',
        'recursos',
        'observacionesPlaneacion',
        'docenteCorreo',
        'actualizado'
      ]);
    }

    match /config/global {
      allow read: if request.auth != null;
      allow write: if esAdmin();
    }

    match /temporadas/{temporadaId}/grupos/{grupoId} {
      allow read: if esAdmin() || esDocente();
      allow create, delete: if esAdmin();
      // Cualquier docente registrado puede guardar planeación (la app ya le
      // muestra solo sus propias clases; validar por correo bloqueaba a
      // docentes cuyas clases quedaron con el correo viejo o vacío).
      allow update: if esAdmin()
        || (esDocente() && soloEditaPlaneacion());
    }

    match /temporadas/{temporadaId}/{sub}/{docId} {
      allow read: if esAdmin() || esDocente();
      allow write: if esAdmin()
        || (esDocente() && sub in ['asistencia', 'musicafe', 'materiales']);
    }

    // Todo lo demás: docente solo lectura, coordinación escribe.
    match /{document=**} {
      allow read: if esAdmin() || esDocente();
      allow write: if esAdmin();
    }
  }
}
