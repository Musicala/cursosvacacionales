{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "legacy/**",
      "migracion/**"
    ],
    "rewrites": [
      { "source": "/api/vacacionales/wix-sessions", "function": "wixSessions" },
      { "source": "**", "destination": "/index.html" }
    ]
  },
  "functions": {
    "source": "functions"
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
